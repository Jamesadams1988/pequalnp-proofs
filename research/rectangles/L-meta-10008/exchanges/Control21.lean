import PEqualNP.Defs

-- The mask verification strategy is adapted from L-meta-10011 and L-meta-10015.
namespace RectangleCover.control21_aux

private def rows : List ℕ := [1141899472, 136315297, 272630594, 545261188, 1090522376, 33561105, 67122210, 134244420, 268488840, 536977680, 1073955360, 427073, 854146, 1708292, 3416584, 6833168, 13666336, 27332672, 54665344, 109330688, 218661376, 437322752, 874645504, 1749291008, 1351098369, 554713091, 1109426182, 71368717, 142737434, 285474868, 570949736]
private def masks : List (ℕ × ℕ) := [(3834113, 537012263), (817905736, 34193729), (1074792081, 283381763), (5115916, 1209040953), (1417748608, 352388737), (470155680, 538707232), (840442144, 1080108096), (550538272, 9445770), (1094734881, 155223300), (1140985914, 340942848), (125109256, 266584), (1080048066, 1103102480), (1829405248, 135400064), (310527750, 101190660), (940644373, 572551168), (16818375, 587563016), (134857226, 1359089730), (178274452, 9076912), (34408529, 405340676), (27535880, 69224490), (604304656, 746586177)]
private def verts (m : ℕ) : Finset (Fin 31) := Finset.univ.filter (fun i => m.testBit i.val)

set_option maxRecDepth 100000 in
private theorem inside : ∀ p ∈ masks, ∀ i : Fin 31, p.1.testBit i.val = true →
    ∀ j : Fin 31, p.2.testBit j.val = true → (rows.getD i.val 0).testBit j.val = false := by decide +kernel

set_option maxRecDepth 100000 in
private theorem covered : ∀ i j : Fin 31, (rows.getD i.val 0).testBit j.val = false →
    ∃ p ∈ masks, p.1.testBit i.val = true ∧ p.2.testBit j.val = true := by decide +kernel

theorem witness : ∃ L : List (Finset (Fin 31) × Finset (Fin 31)), L.length ≤ 21 ∧ (∀ r ∈ L, ∀ i ∈ r.1, ∀ j ∈ r.2, (([1141899472, 136315297, 272630594, 545261188, 1090522376, 33561105, 67122210, 134244420, 268488840, 536977680, 1073955360, 427073, 854146, 1708292, 3416584, 6833168, 13666336, 27332672, 54665344, 109330688, 218661376, 437322752, 874645504, 1749291008, 1351098369, 554713091, 1109426182, 71368717, 142737434, 285474868, 570949736] : List ℕ).getD i.val 0).testBit j.val = false) ∧ ∀ (i : Fin 31) (j : Fin 31), (([1141899472, 136315297, 272630594, 545261188, 1090522376, 33561105, 67122210, 134244420, 268488840, 536977680, 1073955360, 427073, 854146, 1708292, 3416584, 6833168, 13666336, 27332672, 54665344, 109330688, 218661376, 437322752, 874645504, 1749291008, 1351098369, 554713091, 1109426182, 71368717, 142737434, 285474868, 570949736] : List ℕ).getD i.val 0).testBit j.val = false → ∃ r ∈ L, i ∈ r.1 ∧ j ∈ r.2 := by
  refine ⟨masks.map (fun p => (verts p.1, verts p.2)), by decide, ?_, ?_⟩
  · intro r hr i hi j hj
    obtain ⟨p, hp, rfl⟩ := List.mem_map.mp hr
    exact inside p hp i (Finset.mem_filter.mp hi).2 j (Finset.mem_filter.mp hj).2
  · intro i j h
    obtain ⟨p, hp, hi, hj⟩ := covered i j h
    exact ⟨_, List.mem_map_of_mem hp, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hi⟩,
      Finset.mem_filter.mpr ⟨Finset.mem_univ _, hj⟩⟩

end RectangleCover.control21_aux

theorem RectangleCover.control21 : ∃ L : List (Finset (Fin 31) × Finset (Fin 31)), L.length ≤ 21 ∧ (∀ r ∈ L, ∀ i ∈ r.1, ∀ j ∈ r.2, (([1141899472, 136315297, 272630594, 545261188, 1090522376, 33561105, 67122210, 134244420, 268488840, 536977680, 1073955360, 427073, 854146, 1708292, 3416584, 6833168, 13666336, 27332672, 54665344, 109330688, 218661376, 437322752, 874645504, 1749291008, 1351098369, 554713091, 1109426182, 71368717, 142737434, 285474868, 570949736] : List ℕ).getD i.val 0).testBit j.val = false) ∧ ∀ (i : Fin 31) (j : Fin 31), (([1141899472, 136315297, 272630594, 545261188, 1090522376, 33561105, 67122210, 134244420, 268488840, 536977680, 1073955360, 427073, 854146, 1708292, 3416584, 6833168, 13666336, 27332672, 54665344, 109330688, 218661376, 437322752, 874645504, 1749291008, 1351098369, 554713091, 1109426182, 71368717, 142737434, 285474868, 570949736] : List ℕ).getD i.val 0).testBit j.val = false → ∃ r ∈ L, i ∈ r.1 ∧ j ∈ r.2 := RectangleCover.control21_aux.witness
