set_option maxRecDepth 12000
set_option maxHeartbeats 0
theorem sampleRows : ∀ k : Fin 256, target12096 (fun i => (xs.getD i.val 0)[k.val]) = goal[k.val] := by decide +kernel
theorem coversEveryRow : ∀ (r : Fin 64) (i : Fin 6),
    (xs.getD i.val 0)[(rowPosition r).val] = r.val.testBit i.val := by decide +kernel
theorem rootCoverage : nextLayer (outsideList heads) first.1 first.2 = false := by decide +kernel
theorem conditionalSearch (remaining : ∀ p ∈ heads, optimized 10 p.1 p.2 = false) : search 11 xs = false :=
  rejectFull 11 xs (by decide +kernel) (rejectLayer (k := 10) (s := first) (states := heads) rootCoverage remaining)

theorem binaryBound (rejection : search 11 xs = false)
    (C : Circuit) (hg : ∀ g ∈ C.gates, legal g)
    (he : ∀ x : Fin 6 → Bool, C.eval (List.ofFn x) = target12096 x) :
    11 < binaryCost C.gates := by
  by_contra! low
  have init : ∀ u ∈ xs, holds xs.toFinset u := by
    intro u hu
    exact .inr (.inr ⟨u, List.mem_toFinset.mpr hu, .inl rfl⟩)
  have evaluate (k : Fin 256) :
      (C.gates.foldl step (xs.map (bit k))).getD C.output false = bit k goal := by
    let x (i : Fin 6) : Bool := bit k (xs.getD i.val 0)
    have same : List.ofFn x = xs.map (bit k) := by
      apply List.ext_getElem
      · simp [xs]
      · intro i hi hj
        have hlt : i < xs.length := by simpa using hj
        simp only [List.getElem_ofFn, List.getElem_map, x, List.getD_eq_getElem?_getD,
          List.getElem?_eq_getElem hlt, Option.getD_some]
    change C.eval (xs.map (bit k)) = bit k goal
    rw [← same, he]
    exact sampleRows k
  obtain ⟨t, ht, run⟩ := compile C.gates C.output hg xs xs.toFinset init evaluate
  have lift {a b : ℕ} (hab : a ≤ b) (hr : build basicOps t a xs.toFinset) :
      build basicOps t b xs.toFinset := by
    induction hab with
    | refl => exact hr
    | step _ ih => exact Or.inl ih
  exact Bool.noConfusion (rejection.symm.trans (search_complete ht 11 xs (by decide +kernel) (lift low run)))

theorem replacement (remaining : ∀ p ∈ heads, optimized 10 p.1 p.2 = false)
    (witness13 : ∃ C : Circuit, Monotone2 C ∧ C.size ≤ 13 ∧ ∀ x, C.eval (List.ofFn x) = target12096 x)
    (s : ℕ) (h : HasCircuitSize 6 target12096 s) :
    ∃ C : Circuit, Monotone2 C ∧ C.size ≤ s ∧ ∀ x, C.eval (List.ofFn x) = target12096 x := by
  obtain ⟨C,ok,size,ev⟩ := h
  by_cases hn : ∃ g ∈ C.gates, g.op = GateOp.not
  · obtain ⟨g,mem,op⟩ := hn
    have short : binaryCost C.gates < C.size :=
      List.length_filter_lt_length_iff_exists.mpr ⟨g, mem, by simp [isBinary, op]⟩
    have lb := binaryBound (conditionalSearch remaining) C ok ev
    obtain ⟨D,hm,hs,hd⟩ := witness13
    exact ⟨D,hm,by omega,hd⟩
  · refine ⟨C,?_,size,ev⟩
    intro g mem
    obtain ⟨hop,har⟩ := ok g mem
    change g.op = .and ∨ g.op = .or ∨ g.op = .not at hop
    exact ⟨hop.elim Or.inl (fun h => h.elim Or.inr (fun e => (hn ⟨g,mem,e⟩).elim)),har⟩

