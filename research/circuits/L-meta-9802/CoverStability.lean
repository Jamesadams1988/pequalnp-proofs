def certificate (p l : Fin 20) : List ℕ := table[p.val*20+l.val]?.getD []
def separates (x y : ℕ) : Prop := x/40 ≠ y/40 ∧ x/40 ≠ y%40 ∧ x%40 ≠ y/40 ∧ x%40 ≠ y%40
instance (x y : ℕ) : Decidable (separates x y) := by unfold separates; infer_instance

def slot (p l x : ℕ) : Prop := (x/40,x%40) ∈ edges ∨
  (x/40 = x%40 ∧ ((p,x/40) ∈ edges ∨ (x/40,l+20) ∈ edges))
instance (p l x : ℕ) : Decidable (slot p l x) := by unfold slot; infer_instance

def good (p l : Fin 20) : Prop :=
  (certificate p l).length = 23 ∧ (certificate p l).Pairwise separates ∧
  ∀ x ∈ certificate p l, slot p l x
instance (p l : Fin 20) : Decidable (good p l) := by unfold good; infer_instance

theorem row0 : ∀ l : Fin 20, (0,l.val+20) ∉ edges → good 0 l := by decide +kernel
theorem row1 : ∀ l : Fin 20, (1,l.val+20) ∉ edges → good 1 l := by decide +kernel
theorem row2 : ∀ l : Fin 20, (2,l.val+20) ∉ edges → good 2 l := by decide +kernel
theorem row3 : ∀ l : Fin 20, (3,l.val+20) ∉ edges → good 3 l := by decide +kernel
theorem row4 : ∀ l : Fin 20, (4,l.val+20) ∉ edges → good 4 l := by decide +kernel
theorem row5 : ∀ l : Fin 20, (5,l.val+20) ∉ edges → good 5 l := by decide +kernel
theorem row6 : ∀ l : Fin 20, (6,l.val+20) ∉ edges → good 6 l := by decide +kernel
theorem row7 : ∀ l : Fin 20, (7,l.val+20) ∉ edges → good 7 l := by decide +kernel
theorem row8 : ∀ l : Fin 20, (8,l.val+20) ∉ edges → good 8 l := by decide +kernel
theorem row9 : ∀ l : Fin 20, (9,l.val+20) ∉ edges → good 9 l := by decide +kernel
theorem row10 : ∀ l : Fin 20, (10,l.val+20) ∉ edges → good 10 l := by decide +kernel
theorem row11 : ∀ l : Fin 20, (11,l.val+20) ∉ edges → good 11 l := by decide +kernel
theorem row12 : ∀ l : Fin 20, (12,l.val+20) ∉ edges → good 12 l := by decide +kernel
theorem row13 : ∀ l : Fin 20, (13,l.val+20) ∉ edges → good 13 l := by decide +kernel
theorem row14 : ∀ l : Fin 20, (14,l.val+20) ∉ edges → good 14 l := by decide +kernel
theorem row15 : ∀ l : Fin 20, (15,l.val+20) ∉ edges → good 15 l := by decide +kernel
theorem row16 : ∀ l : Fin 20, (16,l.val+20) ∉ edges → good 16 l := by decide +kernel
theorem row17 : ∀ l : Fin 20, (17,l.val+20) ∉ edges → good 17 l := by decide +kernel
theorem row18 : ∀ l : Fin 20, (18,l.val+20) ∉ edges → good 18 l := by decide +kernel
theorem row19 : ∀ l : Fin 20, (19,l.val+20) ∉ edges → good 19 l := by decide +kernel

theorem checked (p l : Fin 20) (h : (p.val,l.val+20) ∉ edges) : good p l := by
  fin_cases p
  · exact row0 l h
  · exact row1 l h
  · exact row2 l h
  · exact row3 l h
  · exact row4 l h
  · exact row5 l h
  · exact row6 l h
  · exact row7 l h
  · exact row8 l h
  · exact row9 l h
  · exact row10 l h
  · exact row11 l h
  · exact row12 l h
  · exact row13 l h
  · exact row14 l h
  · exact row15 l h
  · exact row16 l h
  · exact row17 l h
  · exact row18 l h
  · exact row19 l h

def chosen (S : Finset ℕ) (x : ℕ) := if x/40 ∈ S then x/40 else x%40

theorem mixedLower (S : Finset ℕ) (cover : ∀ e ∈ edges, e.1 ∈ S ∨ e.2 ∈ S)
    (p l : Fin 20) (hp : p.val ∉ S) (hl : l.val+20 ∉ S) : 23 ≤ S.card := by
  have nm : (p.val,l.val+20) ∉ edges := fun h => (cover _ h).elim hp hl
  obtain ⟨len,sep,leg⟩ := checked p l nm
  have inj : ((certificate p l).map (chosen S)).Nodup := by
    apply List.pairwise_map.mpr
    apply sep.imp
    intro a b hab
    rcases hab with ⟨h1,h2,h3,h4⟩
    simp only [chosen]; split_ifs <;> assumption
  have subs : ((certificate p l).map (chosen S)).toFinset ⊆ S := by
    intro v hv
    obtain ⟨x,hx,rfl⟩ := List.mem_map.mp (List.mem_toFinset.mp hv)
    have hxy : x/40 ∈ S ∨ x%40 ∈ S := by
      rcases leg x hx with e | ⟨eq,e | e⟩
      · exact cover _ e
      · exact Or.inl ((cover _ e).resolve_left hp)
      · exact Or.inl ((cover _ e).resolve_right hl)
    unfold chosen; split_ifs with h
    · exact h
    · exact hxy.resolve_left h
  have count := Finset.card_le_card subs
  rw [List.toFinset_card_of_nodup inj,List.length_map,len] at count
  exact count
end Row9802.CoverStability
#print axioms Row9802.CoverStability.mixedLower
